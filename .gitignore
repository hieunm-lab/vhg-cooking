*.mp4
*.mkv
*.avi
*.mov
*.ts
*.webm
*.flv
*.mp3
*.wav

# === MÔ HÌNH VÀ FILE NHỊ PHÂN ===
*.bin
*.onnx
*.pt
models/
_internal/
bin/

# === PYTHON CACHE & MÔI TRƯỜNG ẢO ===
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
env/

